# Embeddings del matching. Siempre del lado del servidor.
GEMINI_API_KEY=

# Proveedor por defecto del deploy, usado cuando el visitante no carga su propia
# key en el panel "usar tu propia key". Dejar ANTHROPIC_API_KEY sola mantiene el
# comportamiento por defecto (Claude).
ANTHROPIC_API_KEY=

# Para mover el deploy entero a otro proveedor, setear IA_PROVEEDOR con uno de
# anthropic | openai | gemini | openrouter y la key de ese proveedor. IA_MODELO
# es opcional: sin ella se usa el modelo economico de cada uno.
#
#   IA_PROVEEDOR=gemini     -> reusa la GEMINI_API_KEY de arriba, sin cuenta nueva
#   IA_PROVEEDOR=openai     -> necesita OPENAI_API_KEY
#   IA_PROVEEDOR=openrouter -> necesita OPENROUTER_API_KEY
IA_PROVEEDOR=
IA_MODELO=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Legado: se sigue leyendo cuando IA_PROVEEDOR=openai y no hay IA_MODELO.
OPENAI_MODELO=
